# Configuración de base de datos PostgreSQL asincrónica
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<nombre_base>
# OBLIGATORIA: sin esta variable la aplicación no arranca.
# Estructura (cada deploy define sus propios valores; jamás versionar secretos):
DATABASE_URL=postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<nombre_base>

# Diagnóstico de sentencias SQL en consola (true para depuración, false en producción)
SQL_ECHO=false

# Puerto de escucha del servidor
PORT=8000
